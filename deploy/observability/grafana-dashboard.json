{
  "title": "LoopForge",
  "uid": "loopforge-ops",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["loopforge"],
  "panels": [
    {"id": 1, "type": "timeseries", "title": "API requests / s by status class", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (status_class) (rate(loopforge_http_requests_total[5m]))", "legendFormat": "{{status_class}}"}]},
    {"id": 2, "type": "timeseries", "title": "API latency p50 / p95", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "targets": [
       {"expr": "histogram_quantile(0.5, sum by (le) (rate(loopforge_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50"},
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(loopforge_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}]},
    {"id": 3, "type": "stat", "title": "Jobs queued", "gridPos": {"x": 0, "y": 8, "w": 4, "h": 5},
     "targets": [{"expr": "loopforge_jobs_queued"}]},
    {"id": 4, "type": "stat", "title": "Jobs running", "gridPos": {"x": 4, "y": 8, "w": 4, "h": 5},
     "targets": [{"expr": "loopforge_jobs_running"}]},
    {"id": 5, "type": "stat", "title": "Oldest queued job (s)", "gridPos": {"x": 8, "y": 8, "w": 4, "h": 5},
     "targets": [{"expr": "loopforge_jobs_oldest_queued_age_seconds"}]},
    {"id": 6, "type": "timeseries", "title": "Run leases (active / expired) and takeovers", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 5},
     "targets": [
       {"expr": "loopforge_active_leases", "legendFormat": "active"},
       {"expr": "loopforge_expired_leases", "legendFormat": "expired"},
       {"expr": "increase(loopforge_lease_takeovers_total[15m])", "legendFormat": "takeovers / 15m"}]},
    {"id": 7, "type": "bargauge", "title": "Tasks by status", "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8},
     "targets": [{"expr": "loopforge_tasks", "legendFormat": "{{status}}"}]},
    {"id": 8, "type": "timeseries", "title": "Agent calls / s (success vs failed)", "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (outcome) (rate(loopforge_llm_calls_total[5m]))", "legendFormat": "{{outcome}}"}]},
    {"id": 9, "type": "timeseries", "title": "Model tokens / s by agent", "gridPos": {"x": 0, "y": 21, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (agent) (rate(loopforge_llm_tokens_total[5m]))", "legendFormat": "{{agent}}"}]},
    {"id": 10, "type": "timeseries", "title": "Sandbox run time p95 and outcomes", "gridPos": {"x": 12, "y": 21, "w": 12, "h": 8},
     "targets": [
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(loopforge_sandbox_run_duration_seconds_bucket[10m])))", "legendFormat": "p95 s"},
       {"expr": "sum by (outcome) (rate(loopforge_sandbox_runs_total[10m]))", "legendFormat": "{{outcome}}"}]},
    {"id": 11, "type": "stat", "title": "Tokens used this month", "gridPos": {"x": 0, "y": 29, "w": 6, "h": 5},
     "targets": [{"expr": "loopforge_tokens_used_month"}]},
    {"id": 12, "type": "stat", "title": "Version", "gridPos": {"x": 6, "y": 29, "w": 6, "h": 5},
     "targets": [{"expr": "loopforge_build_info", "legendFormat": "{{version}}"}]},
    {"id": 13, "type": "timeseries", "title": "Jobs finished by status (per worker process)", "gridPos": {"x": 12, "y": 29, "w": 12, "h": 5},
     "targets": [{"expr": "sum by (status) (increase(loopforge_jobs_finished_total[15m]))", "legendFormat": "{{status}}"}]}
  ]
}

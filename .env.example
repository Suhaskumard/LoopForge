DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/loopforge
JWT_SECRET=change-me
OPENAI_API_KEY=your_api_key
OPENAI_MODEL=your_supported_model
MAX_ITERATIONS=5
MAX_EXECUTION_SECONDS=120
MAX_TASK_DURATION_SECONDS=900
MAX_TOKEN_BUDGET=30000
ENVIRONMENT=development
LLM_PROVIDER=openai
WORKSPACE_ROOT=./workspaces
# Phase 7: inline (default) runs the loop inside the API; queue hands it to `python -m app.worker`
RUN_MODE=inline
LEASE_TTL_SECONDS=30
WORKER_POLL_SECONDS=1
TRUSTED_PROXY_COUNT=0
# Phase 8: repository import limits and the Node sandbox image
SANDBOX_IMAGE_JS=loopforge-sandbox-node
REPO_MAX_ARCHIVE_BYTES=20000000
REPO_MAX_FILES=2000
REPO_MAX_FILE_BYTES=500000
REPO_MAX_TOTAL_BYTES=20000000
REPO_GIT_ALLOWED_HOSTS=
# Phase 9: per-agent models (empty = OPENAI_MODEL). Cheap for Planner/Documentation, stronger for Repair/Reviewer.
MODEL_PLANNER=
MODEL_BUILDER=
MODEL_REPAIR=
MODEL_REVIEWER=
MODEL_DOCUMENTATION=
COST_PER_1K_TOKENS=0.002
# Phase 10: generic OpenID Connect SSO (disabled while OIDC_ISSUER is empty; https required in production)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
OIDC_SCOPES=openid email profile
# comma list; empty = any verified email domain
OIDC_ALLOWED_DOMAINS=
SSO_FRONTEND_URL=http://localhost:5173/login

# Phase 11: integrations and delivery
# Key that encrypts stored git tokens (empty = derived from JWT_SECRET)
SECRETS_KEY=
# Phase 17: key ring for rotation: {"active":"k2","keys":{"k1":"<>=32 chars>","k2":"<>=32 chars>"}} (docs/operations.md#key-rotation)
KEYRING_JSON=
WEBHOOK_ROTATION_OVERLAP_HOURS=24
# Phase 17: SSO group/domain -> role, e.g. {"lf-admins":{"org":"<org-slug>","role":"admin"}}
OIDC_GROUPS_CLAIM=groups
OIDC_GROUP_ROLE_MAP_JSON=
OIDC_DOMAIN_ORG_MAP_JSON=
# Phase 17: sandbox OCI runtime (runc | runsc | kata). A missing runtime fails closed.
SANDBOX_RUNTIME=runc
SANDBOX_REQUIRE_HARDENED_RUNTIME=false
# Phase 17: queue back-pressure (0 = unlimited; queue mode only)
MAX_QUEUED_JOBS=0
MAX_QUEUED_JOBS_PER_ORG=0
BACKPRESSURE_RETRY_AFTER_SECONDS=30
GITHUB_API_BASE=https://api.github.com
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_SECONDS=30
# Phase 12: operations
METRICS_ENABLED=false
METRICS_TOKEN=
WORKER_METRICS_PORT=0
WORKER_METRICS_HOST=127.0.0.1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
WORKER_RECOVER_SECONDS=10
# single-container deployments only; compose/Kubernetes run the `migrate` service/job once per release
RUN_MIGRATIONS=0
# drills only (LLM_PROVIDER=fake): slows the fake model so a run can be interrupted
FAKE_LLM_DELAY_SECONDS=0
# Phase 13
# per-model prices (USD per 1k tokens), e.g. {"strong-model": 0.01, "cheap-model": 0.0005}; unlisted models use COST_PER_1K_TOKENS
MODEL_PRICES_JSON=
# bearer token required on the worker metrics port (empty = no authentication; use network policy)
WORKER_METRICS_TOKEN=
# containerised worker + real sandbox (docker-compose.worker-docker.yml): a HOST directory, mounted at /data/workspaces
LF_HOST_WORKSPACES=
SANDBOX_HOST_WORKSPACE_ROOT=
# backup.sh / restore.sh: encrypt with openssl (file holding the passphrase), run pg_dump inside a container
BACKUP_PASSPHRASE_FILE=
PG_CONTAINER=
# Phase 15: email (production requires MAIL_BACKEND=smtp)
MAIL_BACKEND=console
MAIL_FROM=LoopForge <no-reply@example.com>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# base URL of the web app, used in links inside emails
APP_BASE_URL=http://localhost:5173
QUOTA_WARN_FRACTION=0.8
